+<style>
+/* ---------- base y variables ---------- */
+:root{
+  --green:#0f2a1f;--green2:#173d2d;--panel:#0d241acc;--panel-solid:#11301f;--line:#f4ecdb24;
+  --cream:#f4ecdb;--cream-2:#f4ecdbcc;--cream-3:#f4ecdb99;--gold:#d4b26a;--gold2:#ecd598;--ink:#14231b;
+  --ok:#5fd39a;--bad:#ff8a7c;--warn:#ffd06b;--focus:#ffe08a;
+  --t:env(safe-area-inset-top,0px);--b:env(safe-area-inset-bottom,0px);--l:env(safe-area-inset-left,0px);--r:env(safe-area-inset-right,0px);
+  --gap:12px;--edge:12px;--tap:48px;
+}
+*{box-sizing:border-box;margin:0;padding:0}
+[hidden]{display:none!important}
+html,body{width:100%;height:100%;background:var(--green);color:var(--cream);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}
+body{overflow:hidden;overscroll-behavior:none}
+canvas#c{position:fixed;inset:0;width:100%;height:100vh;height:100dvh;display:block;touch-action:none}
+button,input{font:inherit;color:inherit}
+button{cursor:pointer;border:0;background:none}
+button,a,label,input{touch-action:manipulation}   /* sin zoom por doble toque en iOS */
+:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
+kbd{display:inline-block;min-width:1.6em;padding:1px 6px;border:1px solid #f4ecdb59;border-radius:5px;background:#0f2a1f99;font:600 11px/1.5 Inter,sans-serif;text-align:center;color:var(--cream)}
+.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+.brand{font-family:'Playfair Display',Georgia,serif;font-weight:700;letter-spacing:-.5px;line-height:1}
+.brand b{color:var(--gold);font-weight:700}
+
+/* ---------- carga ---------- */
+#load{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:radial-gradient(120% 90% at 50% 20%,#1d4a37,var(--green) 70%);transition:opacity .6s}
+#load.gone{opacity:0;pointer-events:none}
+.load-in{text-align:center;width:min(340px,84vw);max-width:100%;display:flex;flex-direction:column;align-items:center}
+.load-in .bar{width:100%}
+.load-title{font-family:'Playfair Display',Georgia,serif;font-size:22px;font-weight:700;margin-top:22px;line-height:1.2}
+#load-hint{font-size:13px;color:var(--cream-2);margin-top:8px;line-height:1.5}
+#load[data-state=error] .bar{display:none}
+#load[data-state=error] #load-txt{font-size:15px;color:var(--cream);margin-top:8px;line-height:1.5}
+.load-actions{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;margin-top:16px}
+.load-actions .btn{width:min(100%,260px);min-height:48px;margin:0;justify-content:center;text-align:center;text-decoration:none}
+.load-actions a.btn{color:var(--cream)}
+#load-details{margin-top:14px;font-size:13px;color:var(--cream-2);text-align:left;width:100%}
+#load-details summary{cursor:pointer;text-align:center;color:var(--gold2)}
+#load-details pre{margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;line-height:1.5;max-height:30vh;overflow:auto;padding:8px;border-radius:8px;background:#0d241a99}
+.load-in .brand{font-size:44px}
+.bar{height:4px;background:#ffffff1f;border-radius:2px;overflow:hidden;margin:26px 0 10px}
+.bar i{display:block;height:100%;width:0;background:var(--gold2);transition:width .25s}
+#load-txt{font-size:13px;color:var(--cream-2)}
+
+/* ---------- botones ---------- */
+.btn{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;padding:12px 18px;border-radius:12px;font-weight:600;font-size:16px;text-align:left;
+  background:#f4ecdb12;border:1px solid #f4ecdb40;transition:background .15s,border-color .15s}
+.btn small{display:block;font-weight:400;font-size:13px;color:var(--cream-2);margin-top:2px}
+.btn:hover{background:#f4ecdb1f;border-color:#f4ecdb66}
+.btn:active{background:#f4ecdb2a}
+.btn.primary{background:var(--gold2);color:var(--ink);border-color:var(--gold2)}
+.btn.primary small{color:#14231bd6}
+.btn.primary:hover{background:#f3e0ad}
+.btn.quiet{background:none;border-color:transparent;min-height:44px;padding:8px 4px;font-size:15px;text-decoration:underline;text-underline-offset:3px}
+.btn.danger{color:#ffd2cc;border-color:#ff8a7c55}
+.btns{display:grid;gap:10px;max-width:440px}
+
+/* ---------- inicio ---------- */
+#menu{position:fixed;inset:0;z-index:30;overflow:auto;display:flex;flex-direction:column;justify-content:flex-start;
+  padding:calc(64px + var(--t)) calc(20px + var(--r)) calc(22px + var(--b)) calc(20px + var(--l));
+  background:linear-gradient(0deg,#0b1f17f5 0%,#0b1f17d9 45%,#0b1f1733 75%,#0b1f1700 100%)}
+#menu.hidden,#hud.hidden{display:none}
+.menu-top{position:absolute;top:calc(16px + var(--t));left:calc(20px + var(--l));right:calc(20px + var(--r));display:flex;justify-content:space-between;align-items:center}
+.menu-top .brand{font-size:24px}
+.chip.back{display:inline-flex;align-items:center;gap:1px;color:var(--cream);text-decoration:none;font-family:Inter,system-ui,sans-serif}
+.chip.back b{color:#00f2cf;font-weight:700}
+.chip.back:hover{border-color:#f4ecdb99}
+.menu-brand{font-size:26px;margin-bottom:10px}
+.langseg{display:inline-flex;border:1px solid #f4ecdb40;border-radius:999px;overflow:hidden;background:#0d241acc}
+.langseg button{min-width:44px;min-height:44px;padding:0 12px;font:700 14px/1 Inter,system-ui,sans-serif;letter-spacing:1px;color:var(--cream-2);background:transparent;border:0;transition:background .15s,color .15s}
+.langseg button+button{border-left:1px solid #f4ecdb40}
+.langseg button[aria-pressed=true]{background:var(--gold2);color:var(--ink)}
+.langseg button:focus-visible{outline:2px solid var(--gold2);outline-offset:-2px}
+.langseg.big button{min-width:64px}
+.menu-top .right{display:flex;gap:8px;align-items:center}
+.chip{font-size:14px;font-weight:600;min-height:44px;padding:10px 16px;border-radius:999px;background:#0d241acc;border:1px solid #f4ecdb40}
+.menu-body{max-width:520px;margin-top:auto}   /* abajo, pero si no entra se desplaza en vez de quedar bajo la barra superior */
+@media (orientation:portrait) and (max-height:700px){.menu-body .eyebrow{display:none}}
+.eyebrow{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--gold2);font-weight:600}
+.menu-body h1{font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:clamp(38px,8vw,64px);line-height:1.04;letter-spacing:-1px;margin:8px 0 12px}
+.menu-body p.lead{font-size:16px;line-height:1.55;color:var(--cream);max-width:440px;margin-bottom:20px;text-shadow:0 1px 8px #0b1f17}
+.best{font-size:14px;color:var(--cream-2);margin-top:12px}
+.best:empty{display:none}
+.links{display:flex;flex-wrap:wrap;gap:4px 18px;margin-top:10px}
+.links a{color:inherit}
+.menu-foot{font-size:12px;color:var(--cream-3);margin-top:6px}
+@media (min-width:900px) and (orientation:landscape){#menu .menu-body{margin-bottom:auto}#menu{background:linear-gradient(90deg,#0b1f17f2 0%,#0b1f17c4 38%,#0b1f1700 66%);padding-left:calc(6vw + var(--l))}}
+@media (orientation:landscape) and (max-height:520px){
+  #menu .menu-body{margin-bottom:auto}
+  #menu{padding-top:calc(60px + var(--t));background:linear-gradient(90deg,#0b1f17f2 0%,#0b1f17c4 44%,#0b1f1700 72%)}
+  .menu-body .eyebrow{display:none}.menu-body h1{font-size:26px;margin:0 0 4px}.menu-body h1 br{display:none}.menu-body p.lead{display:none}
+  #menu .btn{min-height:42px;padding:6px 14px}#menu .btn small{font-size:12px}
+  .menu-brand{font-size:20px;margin-bottom:4px}
+  #menu .btn.quiet{min-height:44px;padding:6px 4px}
+  .btn{min-height:46px;padding:8px 16px}.btns{gap:8px;max-width:380px}
+}
+
+/* ---------- HUD: datos (sin forma de botón) ---------- */
+#hud{position:fixed;inset:0;z-index:20;pointer-events:none}
+.data{background:#0d241a99;border-radius:8px;padding:4px 10px}
+.data .lbl{display:block;font-size:11px;color:var(--cream-2);line-height:1.3}
+.data .val{display:block;font-size:16px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.2}
+.data .val small{font-size:13px;font-weight:600;color:var(--cream-2);margin-left:2px}
+.hud-top{position:absolute;top:calc(var(--edge) + var(--t));left:calc(var(--edge) + var(--l));right:calc(var(--edge) + var(--r));display:flex;gap:8px;align-items:flex-start}
+.h-target{min-width:0}
+.h-target .val{font-size:15px}
+.h-score{display:flex;gap:12px}
+.h-score>div{min-width:52px}
+.h-actions{margin-left:auto;display:flex;gap:8px}
+#hud.train .h-score{display:none}
+/* acciones del HUD: superficie y borde de botón */
+.hbtn{pointer-events:auto;width:44px;height:44px;padding:0;border-radius:10px;background:#0d241a99;border:1px solid #f4ecdb40;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600}
+.hbtn:hover{border-color:#f4ecdb99}
+.hbtn svg{width:18px;height:18px;flex:none}
