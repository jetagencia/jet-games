+.h-timer small,.g-val span,.boost span,.touch-on .g-val span{font-size:12px;letter-spacing:.06em;line-height:1.25}
+/* ---------- VIS-RAID-04: señalética de objetivos ---------- */
+.marker i{box-shadow:0 0 6px color-mix(in srgb,var(--c) 40%,transparent)}
+.marker b{font-family:var(--body);font-size:13px;font-weight:600;letter-spacing:.02em;text-shadow:0 1px 3px rgba(0,0,0,.8);background:rgba(3,9,14,.8);padding:2px 5px;border-radius:4px}
+.marker.rival b{font-size:10px}
+.marker.pulse i{animation:mpulse .6s ease-in-out 2 alternate}
+@keyframes mpulse{from{transform:rotate(45deg);opacity:1}to{transform:rotate(45deg);opacity:.72}}
+/* ---------- VIS-RAID-05: advertencias contenidas ---------- */
+.timer.danger{color:var(--red);opacity:1;animation:none;border-bottom:2px solid var(--red)}
+.h-alert{background:rgba(120,10,14,.88)}
+.h-alert.on{animation:none}
+@keyframes pop{0%{opacity:0;transform:translate(-50%,-50%) scale(1.04)}20%{opacity:1;transform:translate(-50%,-50%) scale(1)}75%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1)}}
+@keyframes popbig{0%{opacity:0;transform:translate(-50%,-50%) scale(1.04);letter-spacing:.08em}18%{opacity:1;transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-60%)}}
+@media (prefers-reduced-motion:reduce){
+  .marker.pulse i{animation:none;opacity:1}
+  .count.go{animation:none!important;opacity:1;transform:translate(-50%,-50%)}
+  .count:not(.go){opacity:0}
+  .rotate svg{animation:none}
+}
+/* RSP-RAID-03: en anchos cortos la barra superior deja libres 200 px (4×44 + 3×8) más insets para las acciones del HUD */
+@media (max-width:740px){
+  .h-top{left:calc(12px + var(--sal));transform:none;min-width:0;max-width:calc(100vw - 236px - var(--sal) - var(--sar))}
+  .h-top-row{flex-wrap:wrap;justify-content:center;row-gap:2px}
+  .h-top .h-objective{white-space:normal}
+}
