+.toast.bad{border-color:rgba(255,77,77,.6);color:#ffe0e0;background:rgba(80,10,14,.7)}
+.toast.blue{border-color:rgba(74,163,255,.7);color:#e2f0ff}
+.toast.gold{border-color:rgba(255,194,58,.7);color:#fff3d6}
+.count{position:absolute;top:38%;left:50%;transform:translate(-50%,-50%) scale(.6);font-weight:700;opacity:0;pointer-events:none;text-align:center;white-space:nowrap}
+.count.num{font-size:160px;color:#fff;text-shadow:0 0 40px rgba(255,122,42,.6),0 8px 30px rgba(0,0,0,.6)}
+.count.go-word{font-size:130px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 30px rgba(255,122,42,.6))}
+.count.big{font-size:54px;letter-spacing:.08em;text-shadow:0 0 30px currentColor,0 6px 20px rgba(0,0,0,.6)}
+.count.big.blue{color:#8cc6ff}.count.big.red{color:#ff8a8a}.count.big.gold{color:#ffd77a}.count.big.green{color:#8affb8}
+.count.go{animation:pop 1s var(--ease) forwards}
