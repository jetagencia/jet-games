+.toast{padding:9px 18px;border-radius:12px;background:var(--glass-2);border:1px solid var(--line);font-size:16px;letter-spacing:.04em;opacity:0;transform:translateY(-8px) scale(.96);transition:.3s var(--ease);white-space:nowrap}
+.toast.in{opacity:1;transform:none}.toast.out{opacity:0;transform:translateY(-6px)}
